{
  "manifest_version": 3,
  "name": "Send Celebration for Gmail",
  "version": "1.0.0",
  "description": "Arcade-style fireworks, sound and score every time you send an email. Not affiliated with Google.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/press-start-2p.woff2"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "110"
}
